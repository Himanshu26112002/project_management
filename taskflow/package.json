{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Project & Task Management App with Role-Based Access Control",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js src/index.js",
    "build": "cd client && npm install && npm run build",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
